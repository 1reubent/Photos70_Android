<!-- Center Area: Photo List and Action Buttons -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal">

    <ListView
        android:id="@+id/photoListView"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">

            <Button
                android:id="@+id/addPhotoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Photo" />

            <Button
                android:id="@+id/removePhotoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Remove Photo"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/captionPhotoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Caption Photo"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/displayPhotoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Display Photo"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/addTagButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Tag"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/removeTagButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Remove Tag"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/copyPhotoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Copy Photo"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/movePhotoButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Move Photo"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/slideshowButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Slideshow"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

<!-- Bottom Status Label -->
<TextView
    android:id="@+id/statusLabel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp"
    android:text="Status messages here"
    android:textAppearance="?android:attr/textAppearanceSmall" />
</LinearLayout>
